# ==========================================================
# PetFeeder — variáveis de ambiente
# Copie para .env e ajuste. NÃO faça commit do .env.
#
# Gere segredos fortes com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ==========================================================

# Segredos JWT — OBRIGATÓRIOS em produção (mínimo 32 caracteres).
# Troque pelos valores gerados pelo comando acima.
JWT_SECRET=coloque_aqui_um_segredo_aleatorio_forte_min_32_chars
JWT_REFRESH_SECRET=coloque_aqui_outro_segredo_aleatorio_forte_min_32_chars

# Porta HTTP exposta no host (o container/servidor escuta sempre na 3000).
HTTP_PORT=8080

# Origens permitidas no CORS, separadas por vírgula. Vazio = apenas mesma origem.
# Ex.: CORS_ORIGINS=https://app.seudominio.com,https://www.seudominio.com
CORS_ORIGINS=

# Opcional — caminho do banco SQLite (padrão em produção: /app/data/petfeeder.db).
# DB_PATH=/app/data/petfeeder.db
